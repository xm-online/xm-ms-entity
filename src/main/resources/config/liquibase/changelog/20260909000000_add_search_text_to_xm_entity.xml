<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="searchTextType" value="text" dbms="postgresql"/>
    <property name="searchTextType" value="varchar" dbms="h2"/>
    <property name="searchTextType" value="clob" dbms="oracle"/>

    <changeSet id="20260909000000-1" author="ssenko">
        <addColumn tableName="xm_entity">
            <column name="search_text" type="${searchTextType}">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Always into public: without SCHEMA the extension lands in the first migrated schema and its operator class
         is invisible to the other tenants. Some databases have no public schema (prod entity), so it is created first.
         pg_trgm may need superuser rights; do not fail the migration when it cannot be created. -->
    <changeSet id="20260909000000-2" author="ssenko" dbms="postgresql" runInTransaction="false" failOnError="false">
        <validCheckSum>ANY</validCheckSum>
        <sql>CREATE SCHEMA IF NOT EXISTS public</sql>
        <sql>CREATE EXTENSION IF NOT EXISTS pg_trgm SCHEMA public</sql>
    </changeSet>

    <!-- Skipped, not marked ran, while pg_trgm is not in public (older databases had it in the first migrated
         schema, or another service installed it elsewhere): the app still starts, and the index is created on the
         next start once the extension is moved with ALTER EXTENSION pg_trgm SET SCHEMA public.
         Not CONCURRENTLY: it waits for every open transaction, and the app start-up holds one during migration. -->
    <changeSet id="20260909000000-3" author="ssenko" dbms="postgresql">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="CONTINUE">
            <sqlCheck expectedResult="1">
                select count(*) from pg_extension e join pg_namespace n on n.oid = e.extnamespace
                where e.extname = 'pg_trgm' and n.nspname = 'public'
            </sqlCheck>
        </preConditions>
        <sql>CREATE INDEX IF NOT EXISTS idx_xm_entity_search_text_trgm
             ON xm_entity USING gin (search_text public.gin_trgm_ops) WHERE search_text IS NOT NULL</sql>
    </changeSet>

</databaseChangeLog>
