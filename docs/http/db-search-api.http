# ---------- 2.D Sorting and paging ----------

### 2.45 sort by jsonb number desc: positions 9,7,5,3,2,1
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&sort=data.position,desc
Authorization: Bearer {{token}}

> {%
    client.test("positions desc", () => client.assert(response.body.map(e => e.data.position).join(",") === "9,7,5,3,2,1", response.body.map(e => e.data.position).join(",")));
%}

### 2.46 multi sort: stateKey asc, then data.orderNo desc
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&sort=stateKey,asc&sort=data.orderNo,desc
Authorization: Bearer {{token}}

> {%
    client.test("order", () => client.assert(response.body.map(e => e.name).join(",") === "Express Odesa,Beta Kyiv,Alpha Kyiv,Delta Kyiv,Quiet Kyiv,Gamma Lviv", response.body.map(e => e.name).join(",")));
%}

### 2.47 paging: page 1 of size 2 sorted by data.orderNo asc -> o3,o4; X-Total-Count still 6
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&sort=data.orderNo,asc&page=1&size=2
Authorization: Bearer {{token}}

> {%
    client.test("total 6", () => client.assert(response.headers.valueOf("X-Total-Count") === "6", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("page content", () => client.assert(response.body.map(e => e.data.orderNo).join(",") === "3,4", response.body.map(e => e.data.orderNo).join(",")));
%}

### 2.48 everything together: text + column + jsonb in + sort + page size 1: total 2, first is Beta (position 9)
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=kyiv&stateKey.eq=ACTIVE&data.orderNo.in=1,2,3&sort=data.position,desc&page=0&size=1
Authorization: Bearer {{token}}

> {%
    client.test("total 2", () => client.assert(response.headers.valueOf("X-Total-Count") === "2", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("one row, Beta first", () => client.assert(response.body.length === 1 && response.body[0].name === "Beta Kyiv", JSON.stringify(response.body.map(e => e.name))));
%}

# ---------- 2.E POST variant: same grammar, values keep their JSON types, page/size/sort stay in the URL ----------

### 2.49 POST with typed filter values
POST {{host}}/api/_search-db/xm-entities?sort=data.orderNo,desc&size=10
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "typeKey": "DBS-ORDER",
  "query": "kyiv",
  "filter": {
    "data.orderNo.in": [1, 2, 3],
    "data.position.gte": 5,
    "stateKey.eq": "ACTIVE"
  }
}

> {%
    client.test("total 2", () => client.assert(response.headers.valueOf("X-Total-Count") === "2", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("orderNo desc", () => client.assert(response.body.map(e => e.data.orderNo).join(",") === "2,1", response.body.map(e => e.data.orderNo).join(",")));
%}

### 2.50 POST: boolean, nested string, has on numbers, includeSubTypes=false
POST {{host}}/api/_search-db/xm-entities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "typeKey": "DBS-ORDER",
  "includeSubTypes": false,
  "filter": {
    "data.active.eq": true,
    "data.customer.city.eq": "Kyiv",
    "data.codes.has": 42
  }
}

> {%
    client.test("total 1 (Alpha)", () => client.assert(response.headers.valueOf("X-Total-Count") === "1" && response.body[0].name === "Alpha Kyiv", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 2.51 POST: a numeric-looking string stays a string in JSON (no quoting tricks needed)
POST {{host}}/api/_search-db/xm-entities
Authorization: Bearer {{token}}
Content-Type: application/json

{ "typeKey": "DBS-ORDER", "filter": { "data.customer.address.zip.eq": "01001" } }

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 2.52 POST: startDate range with Instant strings and specified=false on a data path
POST {{host}}/api/_search-db/xm-entities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "typeKey": "DBS-ORDER",
  "filter": { "startDate.gte": "2020-01-01T00:00:00Z", "data.codes.specified": false }
}

> {%
    client.test("total 2 (o4, o6)", () => client.assert(response.headers.valueOf("X-Total-Count") === "2", "total " + response.headers.valueOf("X-Total-Count")));
%}

