###############################################################################
# 3. Search by linked entities
#    3.A link candidates:  GET /api/_search-db/xm-entities/{entityTypeKey}/{idOrKey}/links/{linkTypeKey}
#        target typeKey comes from the link spec; for isUnique links the already linked targets are excluded
#    3.B links of a source: GET /api/_search-db/xm-entities/{idOrKey}/targets/{linkTypeKey}
#        query / filter / sort apply to the target entity; response is a list of links
###############################################################################

