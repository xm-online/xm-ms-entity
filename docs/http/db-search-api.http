###############################################################################
# 4. Add new links and see the searches change
###############################################################################

### 4.1 add o1 -ITEM-> p3 (the last free unique candidate)
POST {{host}}/api/links
Authorization: Bearer {{token}}
Content-Type: application/json

{ "typeKey": "DBS-ORDER.ITEM", "source": { "id": {{o1}} }, "target": { "id": {{p3}} }, "startDate": "2026-09-15T00:00:00Z" }

> {%
    client.global.set("l7", response.body.id);
    client.test("l7 created", () => client.assert(response.status === 201 && response.body.target.id == client.global.get("p3"), "status " + response.status));
%}

### 4.2 unique candidates for o1 ITEM are exhausted now
GET {{host}}/api/_search-db/xm-entities/DBS-ORDER/{{o1}}/links/DBS-ORDER.ITEM
Authorization: Bearer {{token}}

> {%
    client.test("total 0", () => client.assert(response.headers.valueOf("X-Total-Count") === "0", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 4.3 o1 now has 3 ITEM links; the new one is found by target filter
GET {{host}}/api/_search-db/xm-entities/{{o1}}/targets/DBS-ORDER.ITEM?data.sku.eq=G-300
Authorization: Bearer {{token}}

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("is l7", () => client.assert(response.body[0].id == client.global.get("l7"), "id " + response.body[0].id));
%}

