###############################################################################
# 2. Filtration: GET /api/_search-db/xm-entities?typeKey=...&<field>.<op>=value
#    Data set for DBS-ORDER (with subtypes): o1..o6 = 6 entities; o7 is DBS-ORDERX and must never appear here.
###############################################################################

### 2.1 typeKey only: all 6 (subtypes included by default), sorted by name
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&sort=name,asc
Authorization: Bearer {{token}}

> {%
    client.test("total 6", () => client.assert(response.headers.valueOf("X-Total-Count") === "6", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("sorted by name", () => client.assert(response.body[0].name === "Alpha Kyiv" && response.body[5].name === "Quiet Kyiv", response.body.map(e => e.name).join(",")));
    client.test("no DBS-ORDERX", () => client.assert(response.body.every(e => e.typeKey.startsWith("DBS-ORDER.") || e.typeKey === "DBS-ORDER"), "wrong type"));
%}

### 2.2 includeSubTypes=false: exact typeKey only (o1..o4)
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&includeSubTypes=false
Authorization: Bearer {{token}}

> {%
    client.test("total 4", () => client.assert(response.headers.valueOf("X-Total-Count") === "4", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("only DBS-ORDER", () => client.assert(response.body.every(e => e.typeKey === "DBS-ORDER"), "subtype leaked"));
%}

### 2.3 lookalike type DBS-ORDERX is searchable on its own
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDERX&data.orderNo.eq=1
Authorization: Bearer {{token}}

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("Lookalike Kyiv", () => client.assert(response.body[0].name === "Lookalike Kyiv", response.body[0].name));
%}

# ---------- 2.A Full text search (search_text = name, description, data.orderNo, data.customer.city, data.tags) ----------

### 2.4 query=kyiv: name or city contains it, case-insensitive. o1,o2,o4; o6 (QUIET, full text off) excluded
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=kyiv&sort=name,asc
Authorization: Bearer {{token}}

> {%
    client.test("total 3", () => client.assert(response.headers.valueOf("X-Total-Count") === "3", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("names", () => client.assert(response.body.map(e => e.name).join(",") === "Alpha Kyiv,Beta Kyiv,Delta Kyiv", response.body.map(e => e.name).join(",")));
%}

### 2.5 query=vip: matched in data.tags; substring, so "vip-wholesale" (o3) also matches: o1,o2,o3,o5
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=vip
Authorization: Bearer {{token}}

> {%
    client.test("total 4", () => client.assert(response.headers.valueOf("X-Total-Count") === "4", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 2.6 query=odesa: subtype DBS-ORDER.EXPRESS inherited fullTextSearch: true
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=odesa
Authorization: Bearer {{token}}

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("Express Odesa", () => client.assert(response.body[0].typeKey === "DBS-ORDER.EXPRESS", response.body[0].typeKey));
%}

### 2.7 query=quiet: DBS-ORDER.QUIET has fullTextSearch: false, so its name and tags are not indexed
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=quiet
Authorization: Bearer {{token}}

> {%
    client.test("total 0", () => client.assert(response.headers.valueOf("X-Total-Count") === "0", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 2.8 query=discounted: description is part of search_text
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=discounted
Authorization: Bearer {{token}}

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("Alpha Kyiv", () => client.assert(response.body[0].name === "Alpha Kyiv", response.body[0].name));
%}

### 2.9 query=lviv with a column filter: text and filters are AND-ed (o3 is NEW)
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER&query=lviv&stateKey.eq=ACTIVE
Authorization: Bearer {{token}}

> {%
    client.test("total 0", () => client.assert(response.headers.valueOf("X-Total-Count") === "0", "total " + response.headers.valueOf("X-Total-Count")));
%}

