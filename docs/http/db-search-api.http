###############################################################################
# 5. JPQL templates: GET|POST /api/_search-db/xm-entities/template/{templateKey}
#    Templates: config/tenants/T3C7D9636/entity/jpql-templates.yml
#    ENTITY templates return XmEntityDto lists (sortable by column / data.<path>);
#    RAW templates return rows as maps keyed by selection alias (sortable by alias; X-Total-Count needs countQuery).
#    Link state at this point: o1 -ITEM-> p1,p2,p3; o2 -ITEM-> p1
###############################################################################

### 5.1 ENTITY: state + nested city, string params from the query string: o1, o2
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_BY_STATE_AND_CITY?stateKey=ACTIVE&city=Kyiv&sort=name,asc
Authorization: Bearer {{token}}

> {%
    client.test("total 2", () => client.assert(response.headers.valueOf("X-Total-Count") === "2", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("names", () => client.assert(response.body.map(e => e.name).join(",") === "Alpha Kyiv,Beta Kyiv", response.body.map(e => e.name).join(",")));
%}

### 5.2 ENTITY: number param coerced by "params: orderNo: number"
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDER_BY_NO?orderNo=1
Authorization: Bearer {{token}}

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("Alpha Kyiv", () => client.assert(response.body[0].name === "Alpha Kyiv", response.body[0].name));
%}

### 5.3 ENTITY: list param (comma-separated on GET) bound to "in (:states)": o3, o4, o6
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_IN_STATES?states=NEW,CLOSED
Authorization: Bearer {{token}}

> {%
    client.test("total 3", () => client.assert(response.headers.valueOf("X-Total-Count") === "3", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 5.4 ENTITY: boolean param + sort by data path: orderNo 5, 3, 1
GET {{host}}/api/_search-db/xm-entities/template/DBS_ACTIVE_FLAG_ORDERS?active=true&sort=data.orderNo,desc
Authorization: Bearer {{token}}

> {%
    client.test("total 3", () => client.assert(response.headers.valueOf("X-Total-Count") === "3", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("orderNo desc", () => client.assert(response.body.map(e => e.data.orderNo).join(",") === "5,3,1", response.body.map(e => e.data.orderNo).join(",")));
%}

### 5.5 ENTITY: subject param :subjectUserKey, nothing to pass: all 6 orders were created by this user
GET {{host}}/api/_search-db/xm-entities/template/DBS_MY_ORDERS
Authorization: Bearer {{token}}

> {%
    client.test("total 6", () => client.assert(response.headers.valueOf("X-Total-Count") === "6", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 5.6 ENTITY: instant param + paging: page 1 of size 4 -> 2 rows, total 6
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_SINCE?since=2020-01-01T00:00:00Z&page=1&size=4&sort=id,asc
Authorization: Bearer {{token}}

> {%
    client.test("total 6", () => client.assert(response.headers.valueOf("X-Total-Count") === "6", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("2 rows on page 1", () => client.assert(response.body.length === 2, "rows " + response.body.length));
%}

### 5.7 ENTITY: instant in the future -> 0
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_SINCE?since=2100-01-01T00:00:00Z
Authorization: Bearer {{token}}

> {%
    client.test("total 0", () => client.assert(response.headers.valueOf("X-Total-Count") === "0", "total " + response.headers.valueOf("X-Total-Count")));
%}

### 5.8 ENTITY, POST variant: the body is the params map with JSON types
POST {{host}}/api/_search-db/xm-entities/template/DBS_ORDER_BY_NO
Authorization: Bearer {{token}}
Content-Type: application/json

{ "orderNo": 2 }

> {%
    client.test("Beta Kyiv", () => client.assert(response.headers.valueOf("X-Total-Count") === "1" && response.body[0].name === "Beta Kyiv", JSON.stringify(response.body.map(e => e.name))));
%}

### 5.9 RAW: scalar projection with aliases; rows are maps, count header from countQuery
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_SUMMARY?typeKeyPattern=DBS-ORDER.EXPRESS
Authorization: Bearer {{token}}

> {%
    client.test("total 1", () => client.assert(response.headers.valueOf("X-Total-Count") === "1", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("row keys", () => client.assert(response.body[0].name === "Express Odesa" && response.body[0].stateKey === "ACTIVE" && "orderNo" in response.body[0] && "city" in response.body[0], JSON.stringify(response.body[0])));
%}

### 5.10 RAW, POST with a like pattern over all DBS-* types (12 entities); sort by a selection alias replaces the template's order by; paging
POST {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_SUMMARY?sort=name,desc&page=0&size=2
Authorization: Bearer {{token}}
Content-Type: application/json

{ "typeKeyPattern": "DBS-%" }

> {%
    client.test("total 12", () => client.assert(response.headers.valueOf("X-Total-Count") === "12", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("name desc, 2 rows", () => client.assert(response.body.map(r => r.name).join(",") === "Widget,Quiet Kyiv", response.body.map(r => r.name).join(",")));
%}

### 5.11 RAW: aggregation with group by (exact DBS-ORDER only: ACTIVE 2, CLOSED 1, NEW 1); no countQuery -> no X-Total-Count
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDERS_PER_STATE?typeKey=DBS-ORDER
Authorization: Bearer {{token}}

> {%
    client.test("groups", () => client.assert(response.body.map(r => r.stateKey + "=" + r.total).join(",") === "ACTIVE=2,CLOSED=1,NEW=1", JSON.stringify(response.body)));
    client.test("no count header", () => client.assert(response.headers.valueOf("X-Total-Count") === null, "header " + response.headers.valueOf("X-Total-Count")));
%}

### 5.12 RAW: whole entity selection is mapped to XmEntityDto under positional key col0
GET {{host}}/api/_search-db/xm-entities/template/DBS_ENTITIES_RAW?typeKey=DBS-PRODUCT
Authorization: Bearer {{token}}

> {%
    client.test("total 3", () => client.assert(response.headers.valueOf("X-Total-Count") === "3", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("dto in col0", () => client.assert(response.body[0].col0.typeKey === "DBS-PRODUCT" && response.body[0].col0.name === "Gadget", JSON.stringify(response.body[0])));
%}

### 5.13 RAW: join through Link, orders with their products (o1: Gadget, Gizmo Pro, Widget; o2: Widget)
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDER_ITEMS?linkTypeKey=DBS-ORDER.ITEM
Authorization: Bearer {{token}}

> {%
    client.test("total 4", () => client.assert(response.headers.valueOf("X-Total-Count") === "4", "total " + response.headers.valueOf("X-Total-Count")));
    client.test("rows", () => client.assert(response.body.map(r => r.orderName + ":" + r.product).join(",") === "Alpha Kyiv:Gadget,Alpha Kyiv:Gizmo Pro,Alpha Kyiv:Widget,Beta Kyiv:Widget", JSON.stringify(response.body.map(r => r.orderName + ":" + r.product))));
    client.test("sku column", () => client.assert(String(response.body[0].sku).indexOf("G-200") >= 0, "sku " + response.body[0].sku));
%}

### 5.14 RAW: join template sorted by alias from the target entity
GET {{host}}/api/_search-db/xm-entities/template/DBS_ORDER_ITEMS?linkTypeKey=DBS-ORDER.ITEM&sort=product,desc&size=1
Authorization: Bearer {{token}}

> {%
    client.test("Widget first", () => client.assert(response.body[0].product === "Widget", response.body[0].product));
%}

### 5.15 RAW: mixed selection without aliases -> positional keys col0 (DTO) and col1 (scalar)
GET {{host}}/api/_search-db/xm-entities/template/DBS_MIXED_RAW?typeKey=DBS-CUSTOMER
Authorization: Bearer {{token}}

> {%
    client.test("2 rows", () => client.assert(response.body.length === 2, "rows " + response.body.length));
    client.test("col0/col1", () => client.assert(response.body[0].col0.name === "ACME Kyiv" && response.body[0].col1 === "ACME Kyiv", JSON.stringify(response.body[0])));
%}

