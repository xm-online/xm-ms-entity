# DB search API (/api/_search-db/**) end-to-end test flow for the entity microservice.
#
# Run the requests top to bottom (IntelliJ: "Run all requests in file", or CLI: ijhttp docs/http/db-search-api.http).
# Every request carries assertions, so a failing case shows up in the test report.
#
# Prerequisites
#   1. Tenant spec with the DBS-* test types: config/tenants/T3C7D9636/entity/xmentityspec/dbsearch-test.yml
#   2. Entity started locally (8081 was busy with an ssh tunnel, hence 8082):
#        ./gradlew bootRun --args='--spring.profiles.active=dev --server.port=8082'
#   3. The token is taken from the remote UAA of the same tenant (as in wh.http).
#
# Sections
#   0. token and preflight
#   1. test data: 7 orders (3 typeKeys), 3 products, 2 customers, 6 links
#   2. filtration: full text, every operator, column and data fields, typing, sort, paging, POST, errors
#   3. search by linked entities: link candidates (to-link) and links of a source entity (targets)
#   4. add new links and see how the searches change
#   5. JPQL templates (ENTITY and RAW) from entity/jpql-templates.yml
#   6. clean up: links, then entities, then verify nothing is left

@host = http://localhost:8082
###############################################################################
# 0. Token and preflight
###############################################################################

### 0.1 Token
@token = BearerToken


### 0.2 Preflight: the DBS-ORDER type is in the spec and has full text search on
GET {{host}}/api/xm-entity-specs/DBS-ORDER
Authorization: Bearer {{token}}

> {%
    client.test("DBS-ORDER spec present", () => client.assert(response.status === 200, "status " + response.status));
    client.test("fullTextSearch on", () => client.assert(response.body.fullTextSearch === true, "fullTextSearch=" + response.body.fullTextSearch));
%}

### 0.3 Preflight: no leftovers from a previous run (if this fails, run section 6 first or delete the listed ids)
GET {{host}}/api/_search-db/xm-entities?typeKey=DBS-ORDER
Authorization: Bearer {{token}}

> {%
    client.test("no leftover DBS-ORDER entities", () => client.assert(response.headers.valueOf("X-Total-Count") === "0", "leftover ids: " + response.body.map(e => e.id)));
%}

###############################################################################
# 1. Test data
###############################################################################

### 1.1 Order 1: ACTIVE, Kyiv, tags vip+urgent, codes 7+42, nested address, has description
POST {{host}}/api/xm-entities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "DBS-ORDER-1",
  "typeKey": "DBS-ORDER",
  "stateKey": "ACTIVE",
  "name": "Alpha Kyiv",
  "description": "Discounted order",
  "data": {
    "orderNo": 1,
    "position": 5,
    "amount": 100.5,
    "active": true,
    "note": "first",
    "customer": { "city": "Kyiv", "email": "alpha@example.com", "address": { "zip": "01001", "street": "Khreshchatyk" } },
    "tags": ["vip", "urgent"],
    "codes": [7, 42]
  }
}

> {%
    client.global.set("o1", response.body.id);
    client.test("o1 created", () => client.assert(response.status === 201, "status " + response.status));
%}

### 1.2 Order 2: ACTIVE, Kyiv, active=false, tag vip, code 42
POST {{host}}/api/xm-entities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "DBS-ORDER-2",
  "typeKey": "DBS-ORDER",
  "stateKey": "ACTIVE",
  "name": "Beta Kyiv",
  "data": {
    "orderNo": 2,
    "position": 9,
    "amount": 250,
    "active": false,
    "customer": { "city": "Kyiv", "email": "beta@example.com", "address": { "zip": "02002" } },
    "tags": ["vip"],
    "codes": [42]
  }
}

> {%
    client.global.set("o2", response.body.id);
    client.test("o2 created", () => client.assert(response.status === 201, "status " + response.status));
%}

